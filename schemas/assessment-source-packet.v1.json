{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assessment-source-packet.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "compiler_version", "preparation_id", "preparation_semantic_hash", "preparation_inputs", "release_id", "release_commit", "project_authority", "graph_generation", "graph_semantic_hash", "intent_semantic_hash", "mapping_packet_hash", "capabilities_hash", "role_definition_hashes", "discovery_registry_hash", "population", "change_impact", "role_sources", "browser_work_order", "coverage_boundary", "packet_hash"],
  "properties": {
    "schema_version": {"const": "assessment-source-packet.v1"},
    "compiler_version": {"const": "assessment-preparation.v2"},
    "preparation_id": {"$ref": "#/$defs/preparationId"},
    "preparation_semantic_hash": {"$ref": "#/$defs/hash"},
    "preparation_inputs": {"$ref": "#/$defs/preparationInputs"},
    "release_id": {"type": "string", "minLength": 1},
    "release_commit": {"$ref": "#/$defs/commit"},
    "project_authority": {"type": "object", "additionalProperties": false, "required": ["project_id", "contract_hash", "contract_source", "authority_policy_version"], "properties": {"project_id": {"type": "string"}, "contract_hash": {"$ref": "#/$defs/hash"}, "contract_source": {"type": "string"}, "authority_policy_version": {"type": "string"}}},
    "graph_generation": {"type": "string", "pattern": "^gen_[0-9a-f]{32}$"},
    "graph_semantic_hash": {"$ref": "#/$defs/hash"},
    "intent_semantic_hash": {"$ref": "#/$defs/hash"},
    "mapping_packet_hash": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
    "capabilities_hash": {"$ref": "#/$defs/hash"},
    "role_definition_hashes": {"$ref": "#/$defs/roleHashes"},
    "discovery_registry_hash": {"$ref": "#/$defs/hash"},
    "population": {"$ref": "#/$defs/population"},
    "change_impact": {"$ref": "#/$defs/changeImpact"},
    "role_sources": {"type": "object", "additionalProperties": false, "required": ["product_assessment", "engineering_assessment", "test_adequacy", "targeted_test_planning", "browser_journey"], "properties": {"product_assessment": {"$ref": "#/$defs/roleSources"}, "engineering_assessment": {"$ref": "#/$defs/roleSources"}, "test_adequacy": {"$ref": "#/$defs/roleSources"}, "targeted_test_planning": {"$ref": "#/$defs/roleSources"}, "browser_journey": {"$ref": "#/$defs/roleSources"}}},
    "browser_work_order": {"$ref": "#/$defs/browser"},
    "coverage_boundary": {"const": "Validated Product Intent and Session 3 graph plus bounded role-specific commit-pinned context only."},
    "packet_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "preparationId": {"type": "string", "pattern": "^prep_[0-9a-f]{32}$"},
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "ownerPaths": {"type": "object", "additionalProperties": false, "required": ["product_assessment", "engineering_assessment", "test_adequacy", "targeted_test_planning", "browser_journey"], "properties": {"product_assessment": {"$ref": "#/$defs/strings"}, "engineering_assessment": {"$ref": "#/$defs/strings"}, "test_adequacy": {"$ref": "#/$defs/strings"}, "targeted_test_planning": {"$ref": "#/$defs/strings"}, "browser_journey": {"$ref": "#/$defs/strings"}}},
    "preparationInputs": {"type": "object", "additionalProperties": false, "required": ["base_commit", "owner_paths"], "properties": {"base_commit": {"anyOf": [{"$ref": "#/$defs/commit"}, {"type": "null"}]}, "owner_paths": {"$ref": "#/$defs/ownerPaths"}}},
    "roleHashes": {"type": "object", "additionalProperties": false, "required": ["product_assessment", "engineering_assessment", "test_adequacy", "targeted_test_planning", "browser_journey"], "properties": {"product_assessment": {"$ref": "#/$defs/hash"}, "engineering_assessment": {"$ref": "#/$defs/hash"}, "test_adequacy": {"$ref": "#/$defs/hash"}, "targeted_test_planning": {"$ref": "#/$defs/hash"}, "browser_journey": {"$ref": "#/$defs/hash"}}},
    "scope": {"enum": ["confirmed", "explicit_pending_confirmation", "inferred_requires_owner", "blocked_by_ambiguity", "not_applicable"]},
    "population": {"type": "object", "additionalProperties": false, "required": ["requirements", "criteria", "journeys"], "properties": {"requirements": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["requirement_id", "scope_status"], "properties": {"requirement_id": {"type": "string"}, "scope_status": {"$ref": "#/$defs/scope"}}}}, "criteria": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["criterion_id", "requirement_id", "scope_status", "required_evidence_categories", "has_meaningful_repository_or_evidence_reference", "repository_not_applicable_allowed"], "properties": {"criterion_id": {"type": "string"}, "requirement_id": {"type": "string"}, "scope_status": {"$ref": "#/$defs/scope"}, "required_evidence_categories": {"$ref": "#/$defs/strings"}, "has_meaningful_repository_or_evidence_reference": {"type": "boolean"}, "repository_not_applicable_allowed": {"type": "boolean"}}}}, "journeys": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["journey_id", "journey_text", "scope_status"], "properties": {"journey_id": {"type": "string"}, "journey_text": {"type": "string"}, "scope_status": {"$ref": "#/$defs/scope"}}}}}},
    "changeImpact": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["status", "authority", "reason_code"], "properties": {"status": {"const": "unavailable"}, "authority": {"const": "none"}, "reason_code": {"const": "no_authoritative_base"}}}, {"type": "object", "additionalProperties": false, "required": ["status", "authority", "base_commit", "release_commit", "validation", "changed_path_count", "changed_paths"], "properties": {"status": {"const": "available"}, "authority": {"const": "owner_supplied_explicit_base"}, "base_commit": {"$ref": "#/$defs/commit"}, "release_commit": {"$ref": "#/$defs/commit"}, "validation": {"type": "object", "additionalProperties": false, "required": ["base_exists", "release_exists", "base_is_ancestor", "repository_matches"], "properties": {"base_exists": {"const": true}, "release_exists": {"const": true}, "base_is_ancestor": {"const": true}, "repository_matches": {"const": true}}}, "changed_path_count": {"type": "integer", "minimum": 0}, "changed_paths": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "status", "base_blob_hash", "release_blob_hash", "content_inspection"], "properties": {"path": {"type": "string"}, "status": {"enum": ["added", "modified", "deleted", "type_changed"]}, "base_blob_hash": {"type": ["string", "null"]}, "release_blob_hash": {"type": ["string", "null"]}, "content_inspection": {"enum": ["metadata_only", "not_selected"]}}}}}}]},
    "coverage": {"type": "object", "additionalProperties": false, "required": ["coverage_status", "mandatory_files", "candidate_files_considered", "files_included", "files_omitted_due_to_cap", "omitted_paths", "source_text_bytes"], "properties": {"coverage_status": {"enum": ["fully_included", "bounded_incomplete"]}, "mandatory_files": {"type": "integer", "minimum": 0}, "candidate_files_considered": {"type": "integer", "minimum": 0}, "files_included": {"type": "integer", "minimum": 0}, "files_omitted_due_to_cap": {"type": "integer", "minimum": 0}, "omitted_paths": {"$ref": "#/$defs/strings"}, "source_text_bytes": {"type": "integer", "minimum": 0}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["path", "returned_git_path", "git_blob_hash", "normalized_text_hash", "size_bytes", "text", "mandatory", "selection_rule_ids", "selection_reason", "provenance"], "properties": {"path": {"type": "string"}, "returned_git_path": {"type": "string"}, "git_blob_hash": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "normalized_text_hash": {"$ref": "#/$defs/hash"}, "size_bytes": {"type": "integer", "minimum": 0, "maximum": 262144}, "text": {"type": "string"}, "mandatory": {"type": "boolean"}, "selection_rule_ids": {"$ref": "#/$defs/strings"}, "selection_reason": {"type": "string"}, "provenance": {"enum": ["base_graph", "owner_input", "project_contract", "assessment_discovery"]}}},
    "limitation": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["kind", "path", "rule_id"], "properties": {"kind": {"enum": ["assessment_source_missing", "assessment_source_unsupported_git_object", "assessment_source_oversized", "assessment_source_excluded", "assessment_source_unsupported_type", "python_static_import_parse_failed"]}, "path": {"type": "string"}, "rule_id": {"type": "string"}}}, {"type": "object", "additionalProperties": false, "required": ["kind", "criterion_ids", "rule_id"], "properties": {"kind": {"const": "browser_scope_insufficient"}, "criterion_ids": {"$ref": "#/$defs/strings"}, "rule_id": {"const": "release_browser_target_authority"}}}]},
    "roleSources": {"type": "object", "additionalProperties": false, "required": ["coverage", "limitations", "sources"], "properties": {"coverage": {"$ref": "#/$defs/coverage"}, "limitations": {"type": "array", "items": {"$ref": "#/$defs/limitation"}}, "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}, "maxItems": 64}}},
    "target": {"type": "object", "additionalProperties": false, "required": ["url", "origin", "path_pattern", "authority"], "properties": {"url": {"type": "string"}, "origin": {"type": "string"}, "path_pattern": {"type": "string"}, "authority": {"enum": ["deployment_grant", "canonical_runtime_target"]}}},
    "criterionTarget": {"type": "object", "additionalProperties": false, "required": ["criterion_id", "targets"], "properties": {"criterion_id": {"type": "string"}, "targets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/target"}}}},
    "browser": {"type": "object", "additionalProperties": false, "required": ["issued", "reason_code", "assigned_criterion_ids", "assigned_journey_ids", "criterion_targets", "scope_limited_criterion_ids"], "properties": {"issued": {"type": "boolean"}, "reason_code": {"enum": [null, "not_browser_relevant", "browser_capability_unavailable", "browser_permission_not_granted", "no_authorized_browser_target", "browser_scope_insufficient"]}, "assigned_criterion_ids": {"$ref": "#/$defs/strings"}, "assigned_journey_ids": {"$ref": "#/$defs/strings"}, "criterion_targets": {"type": "array", "items": {"$ref": "#/$defs/criterionTarget"}}, "scope_limited_criterion_ids": {"$ref": "#/$defs/strings"}}}
  }
}
