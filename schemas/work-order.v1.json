{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "work-order.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "work_order_id", "work_order_hash", "preparation_id", "preparation_semantic_hash", "release_id", "release_commit", "role_id", "role_version", "role_definition_hash", "role_definition_snapshot_hash", "objective", "inputs", "capability_requirements", "permissions", "required_output", "forbidden_claims"],
  "properties": {
    "schema_version": {"const": "shiproom.work-order.v1"},
    "work_order_id": {"type": "string", "pattern": "^wo_[a-z_]+_[0-9a-f]{16}$"},
    "work_order_hash": {"$ref": "#/$defs/hash"},
    "preparation_id": {"type": "string", "pattern": "^prep_[0-9a-f]{32}$"},
    "preparation_semantic_hash": {"$ref": "#/$defs/hash"},
    "release_id": {"type": "string", "minLength": 1},
    "release_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "role_id": {"enum": ["product_assessment", "engineering_assessment", "test_adequacy", "targeted_test_planning", "browser_journey"]},
    "role_version": {"type": "string"},
    "role_definition_hash": {"$ref": "#/$defs/hash"},
    "role_definition_snapshot_hash": {"$ref": "#/$defs/hash"},
    "objective": {"type": "string", "minLength": 1, "maxLength": 4096},
    "inputs": {"type": "object", "additionalProperties": false, "required": ["packet_path", "packet_hash", "criterion_ids", "requirement_ids", "journey_ids", "allowed_paths", "base_graph_generation", "base_graph_semantic_hash", "product_intent_semantic_hash", "mapping_packet_hash", "change_impact_status"], "properties": {"packet_path": {"type": "string"}, "packet_hash": {"$ref": "#/$defs/hash"}, "criterion_ids": {"$ref": "#/$defs/strings"}, "requirement_ids": {"$ref": "#/$defs/strings"}, "journey_ids": {"$ref": "#/$defs/strings"}, "allowed_paths": {"$ref": "#/$defs/strings"}, "base_graph_generation": {"type": "string"}, "base_graph_semantic_hash": {"$ref": "#/$defs/hash"}, "product_intent_semantic_hash": {"$ref": "#/$defs/hash"}, "mapping_packet_hash": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}, "change_impact_status": {"enum": ["available", "unavailable"]}}},
    "capability_requirements": {"type": "object", "additionalProperties": false, "required": ["file_read", "shell", "browser", "network"], "properties": {"file_read": {"$ref": "#/$defs/requirement"}, "shell": {"$ref": "#/$defs/requirement"}, "browser": {"$ref": "#/$defs/requirement"}, "network": {"$ref": "#/$defs/requirement"}}},
    "permissions": {"type": "object", "additionalProperties": false, "required": ["repository", "shell", "browser"], "properties": {"repository": {"const": "read_only"}, "shell": {"type": "object", "additionalProperties": false, "required": ["allowed_commands"], "properties": {"allowed_commands": {"type": "array", "items": {"$ref": "#/$defs/approvedCommand"}}}}, "browser": {"type": "object", "additionalProperties": false, "required": ["allowed_targets"], "properties": {"allowed_targets": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["url", "origin", "path_pattern", "authority"], "properties": {"url": {"type": "string"}, "origin": {"type": "string"}, "path_pattern": {"type": "string"}, "authority": {"enum": ["deployment_grant", "canonical_runtime_target"]}}}}}}}},
    "required_output": {"type": "object", "additionalProperties": false, "required": ["schema_path", "output_path", "completion_receipt_path", "evidence_directory"], "properties": {"schema_path": {"type": "string"}, "output_path": {"type": "string"}, "completion_receipt_path": {"type": "string"}, "evidence_directory": {"type": "string"}}},
    "forbidden_claims": {"$ref": "#/$defs/strings"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "requirement": {"enum": ["required", "optional", "unavailable"]},
    "approvedCommand": {"type": "object", "additionalProperties": false, "required": ["command_id", "criterion_id", "required_for_release", "argv", "cwd", "purpose", "source", "timeout_seconds", "output_limit_bytes", "allowed_environment"], "properties": {"command_id": {"type": "string", "minLength": 1, "maxLength": 80}, "criterion_id": {"type": "string", "minLength": 1, "maxLength": 120}, "required_for_release": {"type": "boolean"}, "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "cwd": {"type": "string"}, "purpose": {"type": "string", "minLength": 1}, "source": {"type": "object", "additionalProperties": false, "required": ["ref", "hash"], "properties": {"ref": {"type": "string"}, "hash": {"$ref": "#/$defs/hash"}}}, "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 900}, "output_limit_bytes": {"type": "integer", "minimum": 1024, "maximum": 10485760}, "allowed_environment": {"type": "object", "additionalProperties": false, "properties": {"CI": {"type": "string"}, "NO_COLOR": {"type": "string"}, "PYTHONUTF8": {"type": "string"}}}}}
  }
}
