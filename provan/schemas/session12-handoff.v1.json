{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "provan.session12_handoff.v1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  },
  "required": ["schema_id", "candidate", "brief", "preparation", "seed_dispositions", "acceptance_contract", "candidate_freeze", "closure_requirements", "verifier_contracts", "receipt_contracts", "evidence_policy", "protected_invariants", "evidence_settlement", "attestation", "projection_rules", "reinspection", "limitations", "session12_prerequisites", "layer4_matrix", "proof_manifest", "proof_root", "reviewer_receipts", "implementation_binding", "schema_registry", "claim_registry_digest"],
  "properties": {
    "schema_id": {"const": "provan.session12_handoff.v1"},
    "candidate": {"type": "object", "minProperties": 5},
    "brief": {"$ref": "#/$defs/artifact_ref"},
    "preparation": {"$ref": "#/$defs/artifact_ref"},
    "seed_dispositions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact_ref"}},
    "acceptance_contract": {"$ref": "#/$defs/artifact_ref"},
    "candidate_freeze": {"$ref": "#/$defs/artifact_ref"},
    "closure_requirements": {"type": "array", "minItems": 1, "items": {"allOf": [{"$ref": "#/$defs/artifact_ref"}, {"required": ["id"]}]}},
    "verifier_contracts": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/artifact_ref"}},
    "receipt_contracts": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/artifact_ref"}},
    "evidence_policy": {"type": "object", "minProperties": 3},
    "protected_invariants": {"type": "array", "items": {"$ref": "#/$defs/artifact_ref"}},
    "evidence_settlement": {"$ref": "#/$defs/artifact_ref"},
    "attestation": {"$ref": "#/$defs/artifact_ref"},
    "projection_rules": {
      "type": "object",
      "required": ["internal", "client_safe", "record_locator"],
      "additionalProperties": false,
      "properties": {
        "internal": {"type": "string"},
        "client_safe": {"type": "string"},
        "record_locator": {"type": "string"}
      }
    },
    "reinspection": {"$ref": "#/$defs/artifact_ref"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "session12_prerequisites": {"type": "array", "minItems": 5, "items": {"type": "string", "minLength": 1}},
    "layer4_matrix": {"$ref": "#/$defs/artifact_ref"},
    "proof_manifest": {"$ref": "#/$defs/artifact_ref"},
    "proof_root": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "reviewer_receipts": {"type": "array", "items": {"$ref": "#/$defs/artifact_ref"}},
    "implementation_binding": {"type": "object", "minProperties": 8},
    "schema_registry": {"$ref": "#/$defs/artifact_ref"},
    "claim_registry_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
