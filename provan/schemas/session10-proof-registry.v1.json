{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "provan.session10_proof_registry.v1",
  "type": "object",
  "required": ["schema_id", "implementation_commit", "implementation_tree", "entries"],
  "properties": {
    "schema_id": {"const": "provan.session10_proof_registry.v1"},
    "implementation_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "implementation_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "entries": {
      "type": "array",
      "minItems": 52,
      "items": {
        "type": "object",
        "required": ["proof_id", "family", "invariant", "fixture_class", "fixture_path", "schema_id", "schema_result", "python_validator", "python_result", "production_function", "test_id", "artifact_locations", "artifact_hashes", "command", "exit_code", "transcript_hash", "sensitivity"],
        "properties": {
          "proof_id": {"type": "string", "minLength": 1},
          "family": {"type": "string", "pattern": "^S10[A-L]$"},
          "invariant": {"type": "string", "minLength": 1},
          "fixture_class": {"type": "string", "enum": ["valid", "near-valid", "adversarial", "schema-invalid", "schema-valid-python-invalid"]},
          "fixture_path": {"type": "string", "minLength": 1},
          "schema_id": {"type": "string", "minLength": 1},
          "schema_result": {"type": "string", "minLength": 1},
          "python_validator": {"type": "string", "minLength": 1},
          "python_result": {"type": "string", "minLength": 1},
          "production_function": {"type": "string", "minLength": 1},
          "test_id": {"type": "string", "minLength": 1},
          "artifact_locations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "artifact_hashes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
          "command": {"type": "string", "minLength": 1},
          "exit_code": {"type": "integer"},
          "transcript_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "sensitivity": {"const": "PUBLIC_SAFE"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
