{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shiproom://schemas/production-rejection-binding.v1",
  "title": "Production rejection binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "subcase_id", "channel", "production_function",
    "expected_status_or_error", "expected_exception", "receipt_artifact",
    "receipt_hash"
  ],
  "properties": {
    "schema_version": {"const": "production-rejection-binding.v1"},
    "subcase_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "channel": {"enum": ["exception", "returned_status", "persisted_receipt"]},
    "production_function": {"type": "string", "minLength": 3, "maxLength": 512},
    "expected_status_or_error": {"type": "string", "minLength": 1, "maxLength": 512},
    "expected_exception": {"type": ["string", "null"], "maxLength": 256},
    "receipt_artifact": {"type": ["string", "null"], "maxLength": 1024},
    "receipt_hash": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}]}
  }
}
