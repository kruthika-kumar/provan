            "semantic_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "snapshot_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "schema_version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "engineering-assessment-result.v2.json": {
          "type": "object",
          "required": [
            "semantic_hash",
            "snapshot_hash",
            "schema_version"
          ],
          "additionalProperties": false,
          "properties": {
            "semantic_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "snapshot_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "schema_version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "product-assessment-result.v2.json": {
          "type": "object",
          "required": [
            "semantic_hash",
            "snapshot_hash",
            "schema_version"
          ],
          "additionalProperties": false,
          "properties": {
            "semantic_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "snapshot_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "schema_version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "targeted-test-result.v2.json": {
          "type": "object",
          "required": [
            "semantic_hash",
            "snapshot_hash",
            "schema_version"
          ],
          "additionalProperties": false,
          "properties": {
            "semantic_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "snapshot_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "schema_version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "test-adequacy-result.v2.json": {
          "type": "object",
          "required": [
            "semantic_hash",
            "snapshot_hash",
            "schema_version"
          ],
          "additionalProperties": false,
          "properties": {
            "semantic_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "snapshot_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "schema_version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "work-order.v2.json": {
          "type": "object",
          "required": [
            "semantic_hash",
            "snapshot_hash",
            "schema_version"
          ],
          "additionalProperties": false,
          "properties": {
            "semantic_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "snapshot_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "schema_version": {
