{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portable-assessment-manifest.v3.json",
  "type": "object",
  "required": [
    "schema_version",
    "compiler_version",
    "release_id",
    "release_commit",
    "project_authority",
    "preparation_id",
    "preparation_semantic_hash",
    "base_graph_generation",
    "base_graph_semantic_hash",
    "artifact_filenames",
    "artifact_hashes",
    "preparation_snapshot_hashes",
    "result_snapshot_hashes",
    "browser_evidence_snapshot_hashes",
    "semantic_bundle_hash",
    "bundle_hash"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "portable-assessment-manifest.v3"
    },
    "compiler_version": {
      "const": "portable-assessment.v6"
    },
    "release_id": {
      "type": "string"
    },
    "release_commit": {
      "pattern": "^[0-9a-f]{40}$"
    },
    "project_authority": {
      "type": "object",
      "required": [
        "project_id",
        "contract_hash",
        "contract_source",
        "authority_policy_version"
      ],
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string"
        },
        "contract_hash": {
          "$ref": "#/$defs/hash"
        },
        "contract_source": {
          "type": "string"
        },
        "authority_policy_version": {
          "type": "string"
        }
      }
    },
    "preparation_id": {
      "pattern": "^prep_[0-9a-f]{32}$"
    },
    "preparation_semantic_hash": {
      "$ref": "#/$defs/hash"
    },
    "base_graph_generation": {
      "pattern": "^gen_[0-9a-f]{32}$"
    },
    "base_graph_semantic_hash": {
      "$ref": "#/$defs/hash"
    },
    "artifact_filenames": {
      "type": "array",
      "prefixItems": [
        {
          "const": "product-assessment.json"
        },
        {
          "const": "engineering-assessment.json"
        },
        {
          "const": "test-adequacy.json"
        },
        {
          "const": "targeted-test-plan.json"
        },
        {
          "const": "browser-journey.json"
        },
        {
          "const": "assessment-work-orders.json"
        },
        {
          "const": "assessment-graph-overlay.json"
        },
        {
          "const": "effective-assessment-view.json"
        },
        {
          "const": "assessment-compiler-receipts.json"
        }
      ],
      "items": false
    },
    "artifact_hashes": {
      "type": "object",
      "required": [
        "product-assessment.json",
        "engineering-assessment.json",
        "test-adequacy.json",
        "targeted-test-plan.json",
        "browser-journey.json",
        "assessment-work-orders.json",
        "assessment-graph-overlay.json",
        "effective-assessment-view.json",
        "assessment-compiler-receipts.json"
      ],
      "additionalProperties": false,
      "properties": {
        "product-assessment.json": {
          "$ref": "#/$defs/hash"
        },
        "engineering-assessment.json": {
          "$ref": "#/$defs/hash"
        },
        "test-adequacy.json": {
          "$ref": "#/$defs/hash"
        },
        "targeted-test-plan.json": {
          "$ref": "#/$defs/hash"
        },
        "browser-journey.json": {
          "$ref": "#/$defs/hash"
        },
        "assessment-work-orders.json": {
          "$ref": "#/$defs/hash"
        },
        "assessment-graph-overlay.json": {
          "$ref": "#/$defs/hash"
        },
        "effective-assessment-view.json": {
          "$ref": "#/$defs/hash"
        },
        "assessment-compiler-receipts.json": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "preparation_snapshot_hashes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/hash"
      }
    },
    "result_snapshot_hashes": {
      "type": "object",
      "required": [
        "product_assessment",
        "engineering_assessment",
        "test_adequacy",
        "targeted_test_planning"
      ],
      "additionalProperties": false,
      "properties": {
        "product_assessment": {
          "$ref": "#/$defs/resultHashes"
        },
        "engineering_assessment": {
          "$ref": "#/$defs/resultHashes"
        },
        "test_adequacy": {
          "$ref": "#/$defs/resultHashes"
        },
        "targeted_test_planning": {
          "$ref": "#/$defs/resultHashes"
        },
        "browser_journey": {
          "$ref": "#/$defs/resultHashes"
        }
      }
    },
    "browser_evidence_snapshot_hashes": {
      "type": "object",
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {"$ref": "#/$defs/hash"}
    },
    "semantic_bundle_hash": {
      "$ref": "#/$defs/hash"
    },
    "bundle_hash": {
      "$ref": "#/$defs/hash"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "resultHashes": {
      "type": "object",
      "required": [
        "result_semantic_hash",
        "result_snapshot_hash",
        "completion_receipt_snapshot_hash"
      ],
      "additionalProperties": false,
      "properties": {
        "result_semantic_hash": {
          "$ref": "#/$defs/hash"
        },
        "result_snapshot_hash": {
          "$ref": "#/$defs/hash"
        },
        "completion_receipt_snapshot_hash": {
          "$ref": "#/$defs/hash"
        }
      }
    }
  }
}
