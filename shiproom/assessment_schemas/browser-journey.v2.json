{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "browser-journey.v2.json",
  "type": "object",
  "required": ["schema_version", "work_order_id", "criteria", "observations", "judgments"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "browser-journey.v2"},
    "work_order_id": {"type": ["string", "null"], "pattern": "^wo_browser_journey_[0-9a-f]{16}$"},
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["criterion_id", "status", "reason_code", "authorized_targets"],
        "additionalProperties": false,
        "properties": {
          "criterion_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["not_issued", "not_inspected"]},
          "reason_code": {"type": ["string", "null"], "enum": [null, "not_browser_relevant", "browser_capability_unavailable", "browser_permission_not_granted", "no_authorized_browser_target", "browser_scope_insufficient"]},
          "authorized_targets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["url", "origin", "path_pattern", "authority"],
              "additionalProperties": false,
              "properties": {
                "url": {"type": "string"},
                "origin": {"type": "string"},
                "path_pattern": {"type": "string"},
                "authority": {"enum": ["deployment_grant", "canonical_runtime_target"]}
              }
            }
          }
        }
      }
    },
    "observations": {"type": "array", "maxItems": 0},
    "judgments": {"type": "array", "maxItems": 0}
  }
}
