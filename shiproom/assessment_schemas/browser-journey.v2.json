{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"browser-journey.v2.json","type":"object","additionalProperties":false,
  "required":["schema_version","work_order_id","criteria","observations","judgments"],
  "properties":{
    "schema_version":{"const":"browser-journey.v2"},"work_order_id":{"type":["string","null"],"pattern":"^wo_browser_journey_[0-9a-f]{16}$"},
    "criteria":{"type":"array","items":{"$ref":"#/$defs/criterion"}},"observations":{"type":"array","items":{"$ref":"#/$defs/observation"}},"judgments":{"type":"array","items":{"$ref":"#/$defs/judgment"}}
  },
  "$defs":{
    "hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "target":{"type":"object","additionalProperties":false,"required":["url","origin","path_pattern","authority"],"properties":{"url":{"type":"string"},"origin":{"type":"string"},"path_pattern":{"type":"string"},"authority":{"enum":["deployment_grant","canonical_runtime_target"]}}},
    "criterion":{"type":"object","additionalProperties":false,"required":["criterion_id","status","reason_code","authorized_targets"],"properties":{"criterion_id":{"type":"string","minLength":1},"status":{"enum":["not_issued","not_inspected","observed"]},"reason_code":{"type":["string","null"],"enum":[null,"not_browser_relevant","browser_capability_unavailable","browser_permission_not_granted","no_authorized_browser_target","browser_scope_insufficient"]},"authorized_targets":{"type":"array","items":{"$ref":"#/$defs/target"}}}},
    "evidence":{"type":"object","additionalProperties":false,"required":["path","media_type","byte_length","sha256","capture_timestamp"],"properties":{"path":{"type":"string","minLength":1},"media_type":{"enum":["image/png","image/jpeg","application/json","application/x-ndjson","text/plain; charset=utf-8"]},"byte_length":{"type":"integer","minimum":1,"maximum":5242880},"sha256":{"$ref":"#/$defs/hash"},"capture_timestamp":{"type":"string","format":"date-time"}}},
    "observation":{"type":"object","additionalProperties":false,"required":["observation_id","criterion_id","url","action","observed_outcome","redirect_chain","capture_timestamp","evidence_class","evidence"],"properties":{"observation_id":{"pattern":"^browser_observation_[0-9a-f]{24}$"},"criterion_id":{"type":"string"},"url":{"type":"string"},"action":{"type":"string"},"observed_outcome":{"type":"string"},"redirect_chain":{"type":"array","items":{"type":"string"}},"capture_timestamp":{"type":"string","format":"date-time"},"evidence_class":{"const":"browser_observed"},"evidence":{"type":"array","items":{"$ref":"#/$defs/evidence"}}}},
    "judgment":{"type":"object","additionalProperties":false,"required":["judgment_id","criterion_id","observation_ids","conclusion","uncertainty","evidence_class"],"properties":{"judgment_id":{"pattern":"^browser_judgment_[0-9a-f]{24}$"},"criterion_id":{"type":"string"},"observation_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},"conclusion":{"type":"string"},"uncertainty":{"enum":["none","bounded","material"]},"evidence_class":{"const":"model_reviewed"}}}
  }
}
