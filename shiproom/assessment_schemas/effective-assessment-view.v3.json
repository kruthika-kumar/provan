{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "effective-assessment-view.v3.json",
  "type": "object",
  "required": [
    "schema_version",
    "release_id",
    "base_graph_generation",
    "authority",
    "criteria"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "effective-assessment-view.v3"
    },
    "release_id": {
      "type": "string"
    },
    "base_graph_generation": {
      "pattern": "^gen_[0-9a-f]{32}$"
    },
    "authority": {
      "type": "object",
      "required": [
        "base_graph",
        "assessment_overlay",
        "effective_view"
      ],
      "additionalProperties": false,
      "properties": {
        "base_graph": {
          "const": "authoritative_evidence_graph"
        },
        "assessment_overlay": {
          "const": "authoritative_assessment_record"
        },
        "effective_view": {
          "const": "derived_only"
        }
      }
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "criterion_id",
          "base_evidence_state",
          "assessment",
          "assessment_authority",
          "assessment_gap_ids",
          "targeted_test_specification_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "criterion_id": {
            "type": "string"
          },
          "base_evidence_state": {
            "type": "object",
            "required": [
              "implementation",
              "test",
              "instrumentation",
              "runtime"
            ],
            "additionalProperties": false,
            "properties": {
              "implementation": {
                "enum": [
                  "open",
                  "closed",
                  "unknown"
                ]
              },
              "test": {
                "enum": [
                  "open",
                  "closed",
                  "unknown"
                ]
              },
              "instrumentation": {
                "enum": [
                  "open",
                  "closed",
                  "unknown"
                ]
              },
              "runtime": {
                "enum": [
                  "open",
                  "closed",
                  "unknown"
                ]
              }
            }
          },
          "assessment": {
            "type": "object",
            "required": [
              "product_assessment",
              "engineering_assessment",
              "test_adequacy",
              "targeted_test_planning",
              "browser_journey"
            ],
            "additionalProperties": false,
            "properties": {
              "product_assessment": {
                "type": "object"
              },
              "engineering_assessment": {
                "type": "object"
              },
              "test_adequacy": {
                "type": "object"
              },
              "targeted_test_planning": {
                "type": "object"
              },
              "browser_journey": {
                "type": "object",
                "required": [
                  "status",
                  "reason_code",
                  "authorized_targets",
                  "observation_ids",
                  "judgment_ids"
                ],
                "additionalProperties": false,
                "properties": {
                  "status": {
                    "enum": [
                      "not_issued",
                      "not_inspected",
                      "observed"
                    ]
                  },
                  "reason_code": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "authorized_targets": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "url",
                        "origin",
                        "path_pattern",
                        "authority"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "url": {
                          "type": "string",
                          "minLength": 1
                        },
                        "origin": {
                          "type": "string",
                          "minLength": 1
                        },
                        "path_pattern": {
                          "type": "string",
                          "minLength": 1
                        },
                        "authority": {
                          "enum": [
                            "deployment_grant",
                            "canonical_runtime_target"
                          ]
                        }
                      }
                    }
                  },
                  "observation_ids": {"type":"array","uniqueItems":true,"items":{"type":"string"}},
                  "judgment_ids": {"type":"array","uniqueItems":true,"items":{"type":"string"}}
                }
              }
            }
          },
          "assessment_authority": {
            "type": "object",
            "required": [
              "product_assessment",
              "engineering_assessment",
              "test_adequacy",
              "targeted_test_planning",
              "browser_journey"
            ],
            "additionalProperties": false,
            "properties": {
              "product_assessment": {
                "enum": [
                  "model_reviewed",
                  "not_inspected"
                ]
              },
              "engineering_assessment": {
                "enum": [
                  "model_reviewed",
                  "not_inspected"
                ]
              },
              "test_adequacy": {
                "enum": [
                  "model_reviewed",
                  "not_inspected"
                ]
              },
              "targeted_test_planning": {
                "enum": [
                  "model_reviewed",
                  "not_inspected"
                ]
              },
              "browser_journey": {
                "type": "object",
                "required": ["observation_authority", "judgment_authority", "observation_ids", "judgment_ids"],
                "additionalProperties": false,
                "properties": {
                  "observation_authority": {"enum": ["browser_observed", "not_inspected"]},
                  "judgment_authority": {"enum": ["model_reviewed", "not_inspected"]},
                  "observation_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
                  "judgment_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
                }
              }
            }
          },
          "assessment_gap_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "targeted_test_specification_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
