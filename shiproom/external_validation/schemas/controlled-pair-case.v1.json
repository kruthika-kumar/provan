{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,"required":["schema_id","schema_version","case_id","case_authority","repository","commit_sha","snapshot_hash","release_surfaces","applicability","visible_patient_root","buggy_sha","fixed_sha","target_id","oracle_ref","oracle_commitment","release_packet_hash","target_clearance"],"properties":{"schema_id":{"const":"external_validation.controlled_pair_case"},"schema_version":{"const":"1"},"case_id":{"type":"string","pattern":"^case_[0-9a-f]{64}$"},"case_authority":{"type":"object"},"repository":{"type":"string","minLength":1},"commit_sha":{"type":"string","pattern":"^[0-9a-f]{40,64}$"},"snapshot_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"release_surfaces":{"type":"array","minItems":1,"items":{"enum":["ENGINEERING_EXECUTION","PRODUCT_JOURNEY","PRODUCT_MEASUREMENT","DATA_CONTRACT_PIPELINE","AI_EVAL"]}},"applicability":{"type":"object"},"visible_patient_root":{"type":"string","minLength":1},"buggy_sha":{"type":"string","pattern":"^[0-9a-f]{40,64}$"},"fixed_sha":{"type":"string","pattern":"^[0-9a-f]{40,64}$"},"target_id":{"type":"string","minLength":1},"oracle_ref":{"type":"string","minLength":1},"oracle_commitment":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"release_packet_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"target_clearance":{"enum":["named_target_only","not_run"]}}}
