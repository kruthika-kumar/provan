{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "external_validation.session2_budget_policy.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "programme_budget_usd", "warning_threshold_usd", "projection_gate_usd", "hard_stop_usd", "normal_input_ceiling", "absolute_input_ceiling", "normal_call_reservation_usd", "absolute_per_call_cap_usd", "stage_caps", "hosted_tools", "retry_policy", "long_context_policy", "projection_formula"],
  "properties": {
    "schema_id": {"const": "external_validation.session2_budget_policy.v1"},
    "schema_version": {"const": "1"},
    "programme_budget_usd": {"const": 250},
    "warning_threshold_usd": {"const": 175},
    "projection_gate_usd": {"const": 210},
    "hard_stop_usd": {"const": 250},
    "normal_input_ceiling": {"const": 220000},
    "absolute_input_ceiling": {"const": 260000},
    "normal_call_reservation_usd": {"const": 1},
    "absolute_per_call_cap_usd": {"const": 2},
    "stage_caps": {"type": "object", "additionalProperties": false, "required": ["session2_probes", "session3_beta", "beta_rerun_reserve", "session4_controlled", "session5_remediation", "session6_natural", "single_sol_sensitivity", "retry_contingency"]},
    "hosted_tools": {"const": {"web_search": false, "shell": false, "code_interpreter": false}},
    "retry_policy": {"const": "new_attempt_new_reservation"},
    "long_context_policy": {"const": "reject_at_absolute_ceiling"},
    "projection_formula": {"const": "settled+submitted_max+reserved+mandatory_remaining+retry_reserve+sol_reserve"}
  }
}
