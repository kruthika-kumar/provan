{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shiproom.codex-execution-package.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "plan_id", "specialist_id", "native_preparation_id", "native_preparation_semantic_hash", "native_work_order", "native_context_packet", "result_schema", "completion_receipt_schema", "bounded_working_directory", "allowed_files", "native_empty_reason", "forbidden_operations", "timeout_seconds", "expected_result_path", "expected_receipt_path", "execution_mode", "independence_limitations", "package_semantic_hash"],
  "properties": {
    "schema_version": {"const": "codex-execution-package.v1"},
    "package_id": {"type": "string", "minLength": 1}, "plan_id": {"type": "string", "minLength": 1}, "specialist_id": {"type": "string", "minLength": 1},
    "native_preparation_id": {"type": ["string", "null"]}, "native_preparation_semantic_hash": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "native_work_order": {"type": "object", "minProperties": 1}, "native_context_packet": {"type": "object", "minProperties": 1},
    "result_schema": {"type": "string", "minLength": 1}, "completion_receipt_schema": {"type": "string", "minLength": 1},
    "bounded_working_directory": {"type": "string", "minLength": 1}, "allowed_files": {"type": "array", "items": {"type": "string", "minLength": 1}}, "native_empty_reason": {"type": ["string", "null"]},
    "forbidden_operations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "expected_result_path": {"const": "result.json"}, "expected_receipt_path": {"const": "completion-receipt.json"},
    "execution_mode": {"enum": ["native_multi_agent", "isolated_sequential", "single_agent_degraded", "manual_external"]},
    "independence_limitations": {"type": "string", "minLength": 1}, "package_semantic_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
