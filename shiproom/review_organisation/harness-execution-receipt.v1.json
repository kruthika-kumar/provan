{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"harness-execution-receipt.v1","type":"object","additionalProperties":false,"required":["schema_version","work_order_id","execution_mode","declared_capability","granted_permission","observed_execution","execution_receipt","independence_limitation"],"properties":{"schema_version":{"const":"harness-execution-receipt.v1"},"work_order_id":{"type":"string","pattern":"^wo_[a-z_]+_[0-9a-f]{16,24}$"},"execution_mode":{"enum":["native_multi_agent","isolated_sequential","single_agent_degraded","manual_external"]},"declared_capability":{"type":"string","minLength":1,"maxLength":200},"granted_permission":{"type":"string","minLength":1,"maxLength":200},"observed_execution":{"enum":["not_observed","receipt_observed"]},"execution_receipt":{"type":"string","minLength":1,"maxLength":512},"independence_limitation":{"type":"string","minLength":1,"maxLength":1000}}}
