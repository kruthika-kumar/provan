{
  "schema_version": "measurement-guidance-pack.v1",
  "rules": [
    {"rule_id":"MEAS_DECISION_001","claim":"A metric should be interpreted for an explicit decision use.","applicability_conditions":["metric exists","decision question or use is unclear"],"exceptions":["reporting_only"],"allowed_output_classes":["owner_confirmation_question"],"forbidden_output_classes":["deterministic_contract_gap"],"source_ids":["SRC_GOOGLE_HEART_2010"],"maximum_effect":"owner_confirmation"},
    {"rule_id":"MEAS_COUNT_002","claim":"An absolute count may vary with opportunity volume for comparative decisions.","applicability_conditions":["absolute count","comparative decision","opportunity may vary"],"exceptions":["absolute_volume_decision","fixed_opportunity","business_outcome_with_diagnostics","no_incremental_claim"],"allowed_output_classes":["research_backed_warning","contextual_metric_proposal"],"forbidden_output_classes":["automatic_ratio_replacement"],"source_ids":["SRC_MICROSOFT_CONTROLLED_EXPERIMENTS"],"maximum_effect":"non_blocking_warning"},
    {"rule_id":"MEAS_RATIO_003","claim":"Ratio interpretation depends on denominator, zero handling, and aggregation.","applicability_conditions":["rate or ratio used or proposed"],"exceptions":["stable_denominator","release_affects_denominator","zero_handling_defined","aggregation_risk_ruled_out"],"allowed_output_classes":["research_backed_warning","owner_confirmation_question"],"forbidden_output_classes":["ratio_inherently_superior"],"source_ids":["SRC_MICROSOFT_CONTROLLED_EXPERIMENTS"],"maximum_effect":"non_blocking_warning"},
    {"rule_id":"MEAS_POPULATION_004","claim":"Eligibility should be explicit when population changes interpretation.","applicability_conditions":["population materially affects decision"],"exceptions":["universal_eligibility","fixed_eligibility"],"allowed_output_classes":["owner_confirmation_question","research_backed_warning"],"forbidden_output_classes":["invent_cohort_rules"],"source_ids":["SRC_GOOGLE_HEART_2010"],"maximum_effect":"owner_confirmation"},
    {"rule_id":"MEAS_WINDOW_005","claim":"Delayed outcomes require an interpretation window or explicit limitation.","applicability_conditions":["outcome may be delayed","window absent or unclear"],"exceptions":["immediate_outcome","fixed_operational_interval"],"allowed_output_classes":["research_backed_warning","owner_confirmation_question"],"forbidden_output_classes":["impose_arbitrary_window"],"source_ids":["SRC_GOOGLE_HEART_2010","SRC_MICROSOFT_CONTROLLED_EXPERIMENTS"],"maximum_effect":"non_blocking_warning"},
    {"rule_id":"MEAS_PROXY_006","claim":"An intermediate action may not equal the intended outcome.","applicability_conditions":["metric is an intermediate action"],"exceptions":["proxy_is_intended_outcome","validated_diagnostic_use"],"allowed_output_classes":["research_backed_warning"],"forbidden_output_classes":["proxy_universally_invalid"],"source_ids":["SRC_GOOGLE_HEART_2010"],"maximum_effect":"non_blocking_warning"},
    {"rule_id":"MEAS_GUARDRAIL_007","claim":"Material downside guardrails may be relevant to a decision.","applicability_conditions":["target improvement may harm material outcome"],"exceptions":["no_material_downside","guardrail_outside_release_scope"],"allowed_output_classes":["owner_confirmation_question","research_backed_warning"],"forbidden_output_classes":["invent_mandatory_guardrail"],"source_ids":["SRC_GOOGLE_HEART_2010","SRC_MICROSOFT_CONTROLLED_EXPERIMENTS"],"maximum_effect":"non_blocking_warning"},
    {"rule_id":"MEAS_ATTRIBUTION_008","claim":"Causal claims require an appropriate assignment and analysis design.","applicability_conditions":["causal or incremental language"],"exceptions":["descriptive_intent","randomized_assignment","explicit_noncausal_comparison"],"allowed_output_classes":["research_backed_warning"],"forbidden_output_classes":["causality_from_observation"],"source_ids":["SRC_MICROSOFT_CONTROLLED_EXPERIMENTS"],"maximum_effect":"condition_candidate"},
    {"rule_id":"MEAS_SIGNAL_009","claim":"Success and failure signals need distinguishable semantics and properties.","applicability_conditions":["success/failure signal ambiguous"],"exceptions":["single_terminal_state","failure_out_of_scope"],"allowed_output_classes":["owner_confirmation_question","research_backed_warning"],"forbidden_output_classes":["runtime_absence_from_source"],"source_ids":["SRC_GOOGLE_HEART_2010"],"maximum_effect":"owner_confirmation"},
    {"rule_id":"AI_EVAL_010","claim":"A fixed eval requires input, oracle or scoring, pass condition, and linkage.","applicability_conditions":["eval candidate presented as readiness evidence"],"exceptions":["upstream_deterministic_execution"],"allowed_output_classes":["research_backed_warning"],"forbidden_output_classes":["filename_as_eval_proof"],"source_ids":["SRC_NIST_AI_RMF_1_0","SRC_NIST_AI_600_1"],"maximum_effect":"non_blocking_warning"},
    {"rule_id":"AI_FAILURE_011","claim":"AI readiness should cover relevant failure and fallback behavior.","applicability_conditions":["AI surface lacks bounded failure or fallback cases"],"exceptions":["failure_impossible_by_contract","external_bounded_responsibility"],"allowed_output_classes":["research_backed_warning"],"forbidden_output_classes":["invent_required_behavior"],"source_ids":["SRC_NIST_AI_600_1"],"maximum_effect":"non_blocking_warning"},
    {"rule_id":"AI_VERSION_012","claim":"Evaluation interpretation should preserve prompt and model version limitations.","applicability_conditions":["eval or runtime evidence lacks version binding"],"exceptions":["intentional_abstraction_with_limitation"],"allowed_output_classes":["research_backed_warning"],"forbidden_output_classes":["automatic_result_invalidation"],"source_ids":["SRC_NIST_AI_RMF_1_0","SRC_NIST_AI_600_1"],"maximum_effect":"non_blocking_warning"},
    {"rule_id":"AI_JUDGE_013","claim":"LLM judge evidence should state rubric, version, calibration, agreement, and limitations.","applicability_conditions":["LLM judge used"],"exceptions":["deterministic_oracle","human_only_review","calibration_out_of_scope"],"allowed_output_classes":["owner_confirmation_question","research_backed_warning"],"forbidden_output_classes":["uncalibrated_judge_as_deterministic"],"source_ids":["SRC_NIST_AI_600_1"],"maximum_effect":"owner_confirmation"}
  ]
}
