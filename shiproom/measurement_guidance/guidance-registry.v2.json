{
  "schema_version":"measurement-guidance-pack.v2",
  "rules":[
    {"rule_id":"MEAS_DECISION_001","claim":"A metric should be interpreted for an explicit decision use.","trigger":{"any":[{"field":"contract.decision_question","operator":"absent"},{"field":"contract.decision_use_case","operator":"absent"}]},"exceptions":[{"exception_id":"reporting_only","material":true,"project_basis_required":true}],"allowed_output_classes":["owner_confirmation_question"],"forbidden_output_classes":["deterministic_contract_gap"],"source_ids":["SRC_GOOGLE_HEART_2010"],"maximum_effect":"owner_confirmation","qualified_capability":"metric_decision_alignment"},
    {"rule_id":"MEAS_COUNT_002","claim":"An absolute count may vary with opportunity volume for comparative decisions.","trigger":{"all":[{"field":"metric.form","operator":"equals","value":"absolute_count"},{"field":"contract.decision_use_case","operator":"in","value":["comparative_noncausal_review","causal_experiment"]},{"field":"contract.exposure_or_opportunity_definition","operator":"state_is","value":"unresolved"}]},"exceptions":[{"exception_id":"absolute_volume_decision","material":true,"project_basis_required":true},{"exception_id":"fixed_opportunity","material":true,"project_basis_required":true},{"exception_id":"business_outcome_with_diagnostics","material":false,"project_basis_required":true},{"exception_id":"no_incremental_claim","material":true,"project_basis_required":true}],"allowed_output_classes":["research_backed_warning","contextual_metric_proposal"],"forbidden_output_classes":["automatic_ratio_replacement"],"source_ids":["SRC_MICROSOFT_CONTROLLED_EXPERIMENTS"],"maximum_effect":"non_blocking_warning","qualified_capability":"absolute_count_opportunity_review"},
    {"rule_id":"MEAS_RATIO_003","claim":"A ratio requires interpretable numerator, denominator and aggregation.","trigger":{"field":"metric.form","operator":"equals","value":"ratio"},"exceptions":[{"exception_id":"stable_denominator","material":false,"project_basis_required":true},{"exception_id":"release_affects_denominator","material":true,"project_basis_required":true},{"exception_id":"zero_denominator_defined","material":false,"project_basis_required":true},{"exception_id":"aggregation_distortion_ruled_out","material":false,"project_basis_required":true}],"allowed_output_classes":["research_backed_warning","owner_confirmation_question"],"forbidden_output_classes":["automatic_ratio_replacement"],"source_ids":["SRC_MICROSOFT_CONTROLLED_EXPERIMENTS"],"maximum_effect":"non_blocking_warning","qualified_capability":"ratio_denominator_review"},
    {"rule_id":"MEAS_POPULATION_004","claim":"Eligibility changes metric interpretation.","trigger":{"field":"contract.eligible_population","operator":"state_is","value":"unresolved"},"exceptions":[{"exception_id":"universally_eligible_population","material":true,"project_basis_required":true},{"exception_id":"fixed_eligibility","material":true,"project_basis_required":true}],"allowed_output_classes":["owner_confirmation_question","research_backed_warning"],"forbidden_output_classes":["invent_cohort_rule"],"source_ids":["SRC_GOOGLE_HEART_2010"],"maximum_effect":"owner_confirmation","qualified_capability":"population_review"},
    {"rule_id":"MEAS_WINDOW_005","claim":"Delayed outcomes require an interpretable observation window.","trigger":{"any":[{"field":"contract.observation_window","operator":"state_is","value":"unresolved"},{"field":"contract.incomplete_observation_possible","operator":"equals","value":true}]},"exceptions":[{"exception_id":"immediate_outcome","material":true,"project_basis_required":true},{"exception_id":"fixed_operational_interval","material":false,"project_basis_required":true}],"allowed_output_classes":["research_backed_warning","owner_confirmation_question"],"forbidden_output_classes":["automatic_window_replacement"],"source_ids":["SRC_MICROSOFT_CONTROLLED_EXPERIMENTS"],"maximum_effect":"non_blocking_warning","qualified_capability":"window_delay_review"},
    {"rule_id":"MEAS_PROXY_006","claim":"An intermediate action may be a proxy rather than the intended outcome.","trigger":{"field":"metric.role","operator":"equals","value":"diagnostic"},"exceptions":[{"exception_id":"proxy_is_intended_outcome","material":true,"project_basis_required":true},{"exception_id":"validated_diagnostic_use","material":false,"project_basis_required":true}],"allowed_output_classes":["research_backed_warning"],"forbidden_output_classes":["declare_proxy_universally_invalid"],"source_ids":["SRC_GOOGLE_HEART_2010"],"maximum_effect":"non_blocking_warning","qualified_capability":"proxy_outcome_review"},
    {"rule_id":"MEAS_GUARDRAIL_007","claim":"A decision may require a material downside guardrail.","trigger":{"field":"contract.guardrails","operator":"state_is","value":"unresolved"},"exceptions":[{"exception_id":"no_material_downside","material":true,"project_basis_required":true},{"exception_id":"guardrail_outside_release_scope","material":true,"project_basis_required":true}],"allowed_output_classes":["research_backed_warning","owner_confirmation_question"],"forbidden_output_classes":["invent_mandatory_guardrail"],"source_ids":["SRC_GOOGLE_HEART_2010"],"maximum_effect":"non_blocking_warning","qualified_capability":"guardrail_review"},
    {"rule_id":"MEAS_ATTRIBUTION_008","claim":"Causal language requires assignment and exposure support.","trigger":{"field":"contract.inference_intent","operator":"equals","value":"causal_experiment"},"exceptions":[{"exception_id":"descriptive_intent","material":true,"project_basis_required":true},{"exception_id":"randomized_assignment_defined","material":true,"project_basis_required":true},{"exception_id":"explicit_noncausal_comparison","material":true,"project_basis_required":true}],"allowed_output_classes":["research_backed_warning","owner_confirmation_question"],"forbidden_output_classes":["claim_causality_from_observation"],"source_ids":["SRC_MICROSOFT_CONTROLLED_EXPERIMENTS"],"maximum_effect":"condition_candidate","qualified_capability":"causal_claim_review"},
    {"rule_id":"MEAS_SIGNAL_009","claim":"Success and failure signals require distinguishable definitions.","trigger":{"any":[{"field":"contract.success_condition","operator":"state_is","value":"unresolved"},{"field":"contract.failure_condition","operator":"state_is","value":"unresolved"}]},"exceptions":[{"exception_id":"single_terminal_state","material":true,"project_basis_required":true},{"exception_id":"failure_outside_scope","material":true,"project_basis_required":true}],"allowed_output_classes":["owner_confirmation_question","research_backed_warning"],"forbidden_output_classes":["claim_runtime_absence_from_source"],"source_ids":["SRC_GOOGLE_HEART_2010"],"maximum_effect":"owner_confirmation","qualified_capability":"contract_structure"},
    {"rule_id":"AI_EVAL_010","claim":"An eval candidate is not readiness proof without a qualified fixed case.","trigger":{"field":"ai.case_candidate","operator":"equals","value":"candidate"},"exceptions":[{"exception_id":"upstream_deterministic_execution","material":true,"project_basis_required":true}],"allowed_output_classes":["research_backed_warning"],"forbidden_output_classes":["filename_as_eval_proof"],"source_ids":["SRC_NIST_AI_600_1"],"maximum_effect":"non_blocking_warning","qualified_capability":"ai_eval_structure"},
    {"rule_id":"AI_FAILURE_011","claim":"Applicable AI behavior should represent bounded failure and fallback cases.","trigger":{"any":[{"field":"ai.known_failure","operator":"not_equals","value":"established"},{"field":"ai.fallback_case","operator":"not_equals","value":"established"}]},"exceptions":[{"exception_id":"failure_impossible_by_contract","material":true,"project_basis_required":true},{"exception_id":"external_bounded_responsibility","material":true,"project_basis_required":true}],"allowed_output_classes":["research_backed_warning"],"forbidden_output_classes":["invent_required_behavior"],"source_ids":["SRC_NIST_AI_RMF_1_0"],"maximum_effect":"non_blocking_warning","qualified_capability":"ai_eval_structure"},
    {"rule_id":"AI_VERSION_012","claim":"AI evidence should expose prompt/model version binding or an explicit limitation.","trigger":{"field":"ai.prompt_or_model_binding","operator":"not_equals","value":"established"},"exceptions":[{"exception_id":"version_intentionally_abstracted","material":false,"project_basis_required":true}],"allowed_output_classes":["research_backed_warning","owner_confirmation_question"],"forbidden_output_classes":["automatic_result_invalidation"],"source_ids":["SRC_NIST_AI_600_1"],"maximum_effect":"non_blocking_warning","qualified_capability":"ai_claim_authority_review"},
    {"rule_id":"AI_JUDGE_013","claim":"LLM-judge calibration must remain explicit.","trigger":{"field":"ai.judge_type","operator":"equals","value":"llm_judge"},"exceptions":[{"exception_id":"deterministic_oracle","material":true,"project_basis_required":true},{"exception_id":"human_only_review","material":true,"project_basis_required":true},{"exception_id":"calibration_outside_scope","material":true,"project_basis_required":true}],"allowed_output_classes":["owner_confirmation_question","research_backed_warning"],"forbidden_output_classes":["uncalibrated_judge_as_deterministic"],"source_ids":["SRC_NIST_AI_600_1"],"maximum_effect":"owner_confirmation","qualified_capability":"ai_claim_authority_review"}
  ]
}
